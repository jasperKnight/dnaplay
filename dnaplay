class Game:
    def __init__(self, mode, seed, best, demo=False):
        self.mode, self.best_before = mode, best
        self.demo = demo
        self.rng = random.Random(seed)
        star_rng = random.Random(7)
        self.stars = [(star_rng.random(), star_rng.random(), star_rng.choice((0.12, 0.25, 0.45)),
                       star_rng.choice(NEON)) for _ in range(70)]
        self.strand, self.mut, self.bound = [], set(), {}
        self.upper_strand, self.upper_mut, self.upper_bound = [], set(), {}
        self.upper_offset = 0.0
        self.score = self.peak = START_SCORE
        self.heat = float(START_SCORE)
        self.streak = self.best_streak = self.binds = 0
        self.offset = self.t = 0.0
        self.power = {"1": 0, "2": 0}                 # 1 = Helicase, 2 = Polymerase
        self.helicase_until, self.autoguide = 0.0, False
        self.protein, self.codon_buf, self.proteins = "", "", 0
        self.particles, self.floaters, self.flash_good = [], [], {}
        self.msg = ("Pilot your polymer into the matching strand to bind!", ACCENT, 4.0)
        self.shake_until = self.flash_bad_until = 0.0
        self.px, self.py = 12.0, float(TOP + 7)
        self.vx = self.vy = 0.0
        self.facing = (1.0, 0.0)
        self.crashing, self.crash_until = False, 0.0
        self.target, self.target_seq, self.primer = -1, "", ""
        self.target_lane = "lower"
        self.next_target_seq = ""
        self.cols, self.rows = 80, 23
        self.over, self.reason = False, ""

    # ---- geometry --------------------------------------------------------------
    def x_of(self, i):
        return PAD + i * SP - self.offset

    def upper_x_of(self, i):
        return self.cols - PAD - i * SP + self.upper_offset

    def target_x(self):
        return self.x_of(self.target) if self.target_lane == "lower" else self.upper_x_of(self.target)

    def target_near(self):
        if self.target < 0 or self.crashing:
            return False
        target_y = TOP + 3 if self.target_lane == "upper" else self.rows - 4
        return math.hypot(self.px - self.target_x(), self.py - target_y) <= TARGET_ALERT_RANGE

    def index_at(self, x):
        return int((x - PAD + self.offset) // SP)

    def land_row(self):
        return self.rows - 6

    def speed(self):
        s = min(16.0, 3.0 + self.heat * 0.011)       # columns per second
        return s * (0.4 if self.t < self.helicase_until else 1.0)

    def target_length(self):
        return 3 if self.heat < 250 else (4 if self.heat < 600 else 5)

    # ---- the strand --------------------------------------------------------------
    def ensure(self, n):
        """Grow the strand to n bases without creating a second copy of the target."""
        forbidden = [seq for seq in (self.target_seq, self.next_target_seq) if seq]
        while len(self.strand) < n:
            for _ in range(8):
                b = self.rng.choice("ACGT")
                if all(
                    "".join(self.strand[-len(seq) + 1:]) + b != seq
                    for seq in forbidden
                ):
                    break
            self.strand.append(b)
            if self.rng.random() < DECOY_MUTATION_RATE:
                self.mut.add(len(self.strand) - 1)

    def ensure_upper(self, n):
        self.ensure(n)
        while len(self.upper_strand) < len(self.strand):
            i = len(self.upper_strand)
            self.upper_strand.append(PAIR[self.strand[i]])
            if i in self.mut:
                self.upper_mut.add(i)

    def new_primer(self):
        """Place the queued target on either opposing strand."""
        L = len(self.next_target_seq) or self.target_length()
        seq = self.next_target_seq if len(self.next_target_seq) == L else ""
        if not seq:
            seq = "".join(self.rng.choice("ACGT") for _ in range(L))
        self.target_lane = self.rng.choice(("lower", "upper"))
        if self.target_lane == "lower":
            right = self.index_at(self.cols) + 1
            self.target_seq = ""
            self.ensure(right + 64)
            self.ensure_upper(right + 64)
            j = right + self.rng.randint(0, 3)
            del self.strand[j:]
            del self.upper_strand[j:]
            self.mut = {k for k in self.mut if k < j}
            self.upper_mut = {k for k in self.upper_mut if k < j}
            self.upper_bound = {k: v for k, v in self.upper_bound.items() if k < j}
            self.strand.extend(seq)
            self.upper_strand.extend(PAIR[base] for base in seq)
            if self.rng.random() < SITE_MUTATION_CHANCE:
                mutated = j + self.rng.randrange(L)
                self.mut.add(mutated)
                self.upper_mut.add(mutated)
            self.target, self.target_seq = j, seq
            self.ensure(right + 60)
            self.ensure_upper(right + 60)
        else:
            j = max(L - 1, int((self.cols - PAD + self.upper_offset) // SP))
            self.ensure_upper(j + 2)
            for n, base in enumerate(seq):
                self.upper_strand[j - n] = base
                self.strand[j - n] = PAIR[base]
                self.mut.discard(j - n)
            if self.rng.random() < SITE_MUTATION_CHANCE:
                mutated = j - self.rng.randrange(L)
                self.upper_mut.add(mutated)
                self.mut.add(mutated)
            self.target, self.target_seq = j, seq
        self.primer = "".join(PAIR.get(b) for b in seq)
        self.next_target_seq = ""
        preview_length = self.target_length()
        lower_first = max(0, self.index_at(0))
        lower_last = min(len(self.strand) - preview_length, self.index_at(self.cols))
        occupied = {
            "".join(self.strand[k:k + preview_length])
            for k in range(lower_first, lower_last + 1)
        }
        upper_first = max(preview_length - 1, int((self.upper_offset - PAD) // SP))
        upper_last = min(
            len(self.upper_strand) - 1,
            int((self.cols - PAD + self.upper_offset) // SP),
        )
        occupied.update(
            "".join(self.upper_strand[k - n] for n in range(preview_length))
            for k in range(upper_first, upper_last + 1)
        )
        candidates = [
            "".join(bases)
            for bases in itertools.product("ACGT", repeat=preview_length)
            if "".join(bases) not in occupied
        ]
        if not candidates:
            candidates = [
                "".join(bases)
                for bases in itertools.product("ACGT", repeat=preview_length)
                if "".join(bases) not in occupied
            ]
        self.next_target_seq = self.rng.choice(candidates) if candidates else self.target_seq
    # ---- player input ------------------------------------------------------------------
    def key(self, k):
        if k == "1" and self.power.get("1") > 0:
            self.power["1"] -= 1
            self.helicase_until = self.t + HELICASE_SECONDS
            self.say("HELICASE! Strand slowed for 5 seconds", TEAL)
        elif k == "2" and self.power.get("2") > 0 and not self.autoguide:
            self.power["2"] -= 1
            self.autoguide = True
            self.say("POLYMERASE! Guiding your primer in...", GOLD)
        if self.autoguide or self.crashing:
            return
        directions = {
            "left": (-1.0, 0.0), "right": (1.0, 0.0),
            "up": (0.0, -1.0), "down": (0.0, 1.0),
        }
        if k in directions:
            dx, dy = directions[k]
            self.facing = (dx, dy)
            self.vx += dx * SHIP_ACCEL * 0.12
            self.vy += dy * SHIP_ACCEL * 0.12
            self._limit_ship_speed()
        elif k == "drop":
            self.vx += self.facing[0] * SHIP_ACCEL * 0.3
            self.vy += self.facing[1] * SHIP_ACCEL * 0.3
            self._limit_ship_speed()

    def _limit_ship_speed(self):
        speed = math.hypot(self.vx, self.vy)
        if speed > SHIP_MAX_SPEED:
            scale = SHIP_MAX_SPEED / speed
            self.vx *= scale
            self.vy *= scale

    def _demo_pilot(self, dt, rows):
        lane_y = TOP if self.target_lane == "upper" else rows - 3
        center_y = (TOP + rows - 3) / 2.0
        target_velocity = self.speed() * (1.0 if self.target_lane == "upper" else -1.0)
        time_to_lane = abs(lane_y - self.py) / 10.0
        lead_x = self.target_x() + target_velocity * time_to_lane
        x_error = lead_x - self.px
        target_y = lane_y if abs(x_error) <= 1.5 else center_y
        y_error = target_y - self.py
        desired_vx = target_velocity + max(-12.0, min(12.0, x_error * 1.8))
        desired_vy = max(-12.0, min(12.0, y_error * 2.0))
        ax = max(-SHIP_ACCEL, min(SHIP_ACCEL, (desired_vx - self.vx) / max(dt, 0.001)))
        ay = max(-SHIP_ACCEL, min(SHIP_ACCEL, (desired_vy - self.vy) / max(dt, 0.001)))
        self.vx += ax * dt
        self.vy += ay * dt
        self._limit_ship_speed()
        if abs(x_error) > 0.2:
            self.facing = (1.0 if x_error > 0 else -1.0, 0.0)
        elif abs(y_error) > 0.2:
            self.facing = (0.0, 1.0 if y_error > 0 else -1.0)

    def say(self, text, color, secs=2.0):
        self.msg = (text, color, self.t + secs)

    def add(self, pts):
        self.score += pts
        self.peak = max(self.peak, self.score)

    # ---- one frame of game time ------------------------------------------------------
    def update(self, dt, cols, rows):
        self.t += dt
        self.cols, self.rows = cols, rows
        self.heat += (self.score - self.heat) * min(1.0, dt * 0.5)   # lagging difficulty
        move = self.speed() * dt
        self.offset += move
        self.upper_offset += move
        self.ensure(self.index_at(cols) + 60)
        self.ensure_upper(int((cols - PAD + self.upper_offset) // SP) + 60)
        if self.target < 0:
            self.new_primer()
        if self.crashing:
            self.px += self.vx * dt
            self.py += self.vy * dt
            if self.t >= self.crash_until:
                self.crashing = False
                self.autoguide = False
                self.px, self.py = cols / 2.0, (TOP + self.land_row()) / 2.0
                self.vx = self.vy = 0.0
                self.new_primer()
        else:
            old_y = self.py
            if self.autoguide:
                target_y = TOP + 3 if self.target_lane == "upper" else rows - 4
                horizontal_error = self.target_x() - self.px
                self.px += max(-18.0 * dt, min(18.0 * dt, horizontal_error))
                if abs(horizontal_error) <= 1.5:
                    self.py += max(-12.0 * dt, min(12.0 * dt, target_y - self.py))
                self.vx = self.vy = 0.0
            else:
                if self.demo:
                    self._demo_pilot(dt, rows)
                self.px += self.vx * dt
                self.py += self.vy * dt
                drag = math.exp(-SHIP_DRAG * dt)
                self.vx *= drag
                self.vy *= drag
            max_x = max(0.0, cols - len(self.primer) * SP - 1)
            self.px = max(0.0, min(max_x, self.px))
            self.py = max(float(TOP), min(float(rows - 3), self.py))
            if self.demo:
                if self.px <= 0 and self.vx < 0:
                    self.vx = 0.0
                elif self.px >= max_x and self.vx > 0:
                    self.vx = 0.0
            upper_y, lower_y = TOP + 3, rows - 4
            for lane, y in (("upper", upper_y), ("lower", lower_y)):
                crossed = (old_y < y <= self.py) or (old_y > y >= self.py)
                if crossed:
                    self.resolve(lane)
                    break
            if not self.crashing:
                target_x = self.target_x()
                if ((self.target_lane == "lower" and target_x < 0)
                        or (self.target_lane == "upper" and target_x >= cols)):
                    self.escape()
                elif (not self.demo and
                      ((self.px <= 0 and self.vx < -1) or (self.px >= max_x and self.vx > 1))):
                    self.miss()
        self.particles = [p for p in self.particles if p.get("t") > self.t]
        for p in self.particles:
            p["x"] += p.get("vx") * dt
            p["y"] += p.get("vy") * dt
        self.floaters = [f for f in self.floaters if f.get("t") > self.t]
        for f in self.floaters:
            f["y"] -= 3.0 * dt
        old = [i for i in self.bound if i < self.index_at(0) - 10]
        for i in old:
            self.bound.pop(i, None)
            self.flash_good.pop(i, None)
        if self.score <= 0 and not self.over:
            self.over, self.reason = True, "Your score reached zero."

    def resolve(self, lane):
        L = len(self.primer)
        if lane != self.target_lane:
            self.miss(lane)
            return
        if lane == "lower":
            if abs(self.px - self.target_x()) <= MAGNET_RANGE:
                self.px = self.target_x()
            idx = int(round((self.px - PAD + self.offset) / SP))
            seg = "".join(self.strand[idx:idx + L]) if idx >= 0 else ""
        else:
            if abs(self.px - self.target_x()) <= MAGNET_RANGE:
                self.px = self.target_x()
            idx = int(round((self.cols - PAD + self.upper_offset - self.px) / SP))
            seg = "".join(self.upper_strand[idx - k] for k in range(L)) if idx >= L - 1 else ""
        if seg == self.target_seq:
            self.bind(idx)
        else:
            self.miss()

    def bind(self, idx):
        L = len(self.primer)
        self.streak += 1
        self.binds += 1
        self.best_streak = max(self.best_streak, self.streak)
        mult = min(5, 1 + self.streak // 3)
        strand_mut = self.mut if self.target_lane == "lower" else self.upper_mut
        muts = sum(1 for k in (range(idx, idx + L) if self.target_lane == "lower"
                               else range(idx - L + 1, idx + 1)) if k in strand_mut)
        pts = sum(POINTS.get(b, 2) for b in self.target_seq) * mult + muts * MUTATION_BONUS
        self.add(pts)
        if self.target_lane == "lower":
            for k in range(L):
                self.bound[idx + k] = self.primer[k]
                self.flash_good[idx + k] = self.t + 0.6
                self.mut.discard(idx + k)
            x = self.x_of(idx) + L * SP / 2.0
        else:
            for k in range(L):
                strand_idx = idx - k
                self.upper_bound[strand_idx] = self.primer[k]
                self.upper_mut.discard(strand_idx)
            x = self.upper_x_of(idx) + L * SP / 2.0
        y = (self.land_row() if self.target_lane == "lower" else TOP + 5) * 4 + 2
        for n in range(26):
            ang = 2 * math.pi * n / 26
            spd = self.rng.uniform(15, 45)
            self.particles.append({"x": x * 2, "y": y, "vx": spd * math.cos(ang) * 2,
                                   "vy": spd * math.sin(ang), "t": self.t + self.rng.uniform(0.3, 0.7),
                                   "c": self.rng.choice((GOOD, TEAL, WHITE, GOLD))})
        self.floaters.append({"x": x - 2, "y": float(self.land_row() - 1), "s": "+%d" % pts,
                              "c": GOOD, "t": self.t + 1.0})
        text = "BOUND! +%d" % pts
        if mult > 1:
            text += "   x%d COMBO" % mult
        if muts:
            text += "   mutation repaired!"
        self.say(text, GOOD)
        self.codons(self.primer)
        if self.streak % 5 == 0 or self.rng.random() < POWERUP_CHANCE:
            kind = self.rng.choice(("1", "2"))
            if self.power.get(kind) < POWERUP_MAX:
                self.power[kind] += 1
                name = "Helicase" if kind == "1" else "Polymerase"
                self.say("%s   +1 %s (press %s)" % (text, name, kind), GOLD, 2.5)
        self.autoguide = False
        self.new_primer()
        if self.demo:
            self.py = (TOP + self.rows - 3) / 2.0
            self.vx = self.vy = 0.0

    def miss(self, lane=None):
        self.add(-WRONG_PENALTY)
        self.streak = 0
        self.shake_until = self.t + 0.3
        self.flash_bad_until = self.t + 0.4
        self.say("Wrong bind! Polymer flew off   -%d" % WRONG_PENALTY, BAD)
        lane = lane or self.target_lane
        self.vx = -SHIP_MAX_SPEED if self.px > self.cols / 2 else SHIP_MAX_SPEED
        self.vy = -SHIP_MAX_SPEED if lane == "upper" else SHIP_MAX_SPEED
        self.crashing = True
        self.crash_until = self.t + 0.65

    def escape(self):
        L = len(self.primer)
        strand_mut = self.mut if self.target_lane == "lower" else self.upper_mut
        indexes = (range(self.target, self.target + L) if self.target_lane == "lower"
                   else range(self.target - L + 1, self.target + 1))
        doubled = any(k in strand_mut for k in indexes)
        pen = ESCAPE_PENALTY * (2 if doubled else 1)
        self.add(-pen)
        self.streak = 0
        y = (self.rows - 4) * 4 + 2
        for n in range(18):
            self.particles.append({"x": self.rng.uniform(0, 8), "y": y + self.rng.uniform(-6, 6),
                                   "vx": -self.rng.uniform(5, 25), "vy": self.rng.uniform(-8, 8),
                                   "t": self.t + self.rng.uniform(0.4, 0.9), "c": BAD})
        self.floaters.append({"x": 2, "y": float(self.rows - 7), "s": "-%d" % pen, "c": BAD,
                              "t": self.t + 1.0})
        self.say("Site escaped!   -%d%s" % (pen, "  (mutation lost: double)" if doubled else ""), BAD)
        self.new_primer()

    def codons(self, bases):
        self.codon_buf += bases
        while len(self.codon_buf) >= 3:
            codon, self.codon_buf = self.codon_buf[:3], self.codon_buf[3:]
            aa = CODONS.get(codon, "?")
            if aa == "*" or len(self.protein) >= 40:
                if self.protein:
                    bonus = 5 * len(self.protein)
                    self.add(bonus)
                    self.proteins += 1
                    self.say("Protein released! %d amino acids   +%d" % (len(self.protein), bonus), MAGENTA, 2.5)
                self.protein = ""
            else:
                self.protein += aa

    # ---- drawing --------------------------------------------------------------------
    def draw(self, cv, paused=False):
        cols, rows = cv.cols, cv.rows
        strand_row, land = rows - 4, self.land_row()
        upper_row = TOP + 3
        target_near = self.target_near()
        target_blink = GOLD if int(self.t * 6) % 2 == 0 else WHITE
        if self.t < self.shake_until:
            cv.ox = 1 if int(self.t * 30) % 2 else -1
        # background stars (parallax with the strand)
        for sx, sy, depth, col in self.stars:
            x = (sx * cv.w - self.offset * 2 * depth) % cv.w
            y = 4 * 3 + sy * (land * 4 - 12)
            tw = 0.5 + 0.5 * math.sin(self.t * 2.0 + sx * 40)
            cv.dot(x, y, shade(mix((150, 160, 190), col, tw * 0.6), 0.45 + 0.35 * tw))
        # backbone wave under the strand
        for x in range(cv.w):
            y = (strand_row + 1) * 4 + 1 + int(round(1.4 * math.sin((x + self.offset * 2) * 0.21)))
            cv.dot(x, y, (60, 110, 200) if x % 6 < 3 else (170, 60, 70))
        # strand letters, rungs and built (bound) strand
        for i in range(max(0, self.index_at(0)), min(len(self.strand), self.index_at(cols) + 2)):
            x = int(round(self.x_of(i)))
            b = self.strand[i]
            col = BASE_COLORS.get(b)
            if target_near and self.target_lane == "lower" and self.target <= i < self.target + len(self.target_seq):
                col = target_blink
            elif i in self.mut:
                col = mix(MAGENTA, WHITE, 0.5 + 0.5 * math.sin(self.t * 9))
            if self.flash_good.get(i, 0) > self.t:
                col = GOOD
            cv.text_at(x, strand_row, b, col)
            if i in self.bound:
                pb = self.bound.get(i)
                for dy in range(4):
                    cv.dot((x + cv.ox * 0) * 2, (strand_row - 1) * 4 + dy,
                           mix(BASE_COLORS.get(b), BASE_COLORS.get(pb), dy / 3.0))
                glow = self.flash_good.get(i, 0) > self.t
                cv.text_at(x, land, pb, WHITE if glow else mix(BASE_COLORS.get(pb), TEAL, 0.35))
        upper_first = max(0, int((self.upper_offset - PAD) // SP) - 1)
        upper_last = min(
            len(self.upper_strand),
            int((cols - PAD + self.upper_offset) // SP) + 2,
        )
        for i in range(upper_first, upper_last):
            x = int(round(self.upper_x_of(i)))
            base = self.upper_strand[i]
            if target_near and self.target_lane == "upper" and self.target - len(self.target_seq) + 1 <= i <= self.target:
                color = target_blink
            else:
                color = mix(MAGENTA, WHITE, 0.5 + 0.5 * math.sin(self.t * 9)) if i in self.upper_mut else BASE_COLORS[base]
            cv.text_at(x, upper_row, base, color)
            if i in self.upper_bound:
                cv.text_at(x, upper_row + 2, self.upper_bound[i], TEAL)
        # sparks and score pop-ups
        for p in self.particles:
            cv.dot(p.get("x"), p.get("y"), p.get("c"))
        for f in self.floaters:
            cv.text_at(f.get("x"), f.get("y"), f.get("s"), f.get("c"))
        # The polymer primer is piloted like a small ship.
        L = len(self.primer)
        bad = self.t < self.flash_bad_until
        y = int(self.py)
        for x in range(int(self.px * 2), int((self.px + L * SP - 1) * 2)):
            cv.dot(x, y * 4 - 1, GOLD if self.autoguide else TEAL)
        for k, b in enumerate(self.primer):
            c = BAD if bad else (mix(BASE_COLORS.get(b), GOLD, 0.5) if self.autoguide else BASE_COLORS.get(b))
            cv.text_at(int(round(self.px)) + k * SP, y, b, c)
        if self.facing == (1.0, 0.0):
            ship = ">"
        elif self.facing == (-1.0, 0.0):
            ship = "<"
        elif self.facing == (0.0, -1.0):
            ship = "^"
        else:
            ship = "v"
        cv.text_at(int(round(self.px)) - 2, y, ship, BAD if self.crashing else GOLD)
        if target_near:
            target_row = upper_row if self.target_lane == "upper" else strand_row
            for k, base in enumerate(self.target_seq):
                target_x = (self.upper_x_of(self.target - k) if self.target_lane == "upper"
                            else self.x_of(self.target + k))
                cv.text_at(int(round(target_x)), target_row, base, target_blink)
        self.draw_hud(cv)
        if paused:
            cv.centre(rows // 2 - 1, "  P A U S E D  ", GOLD)
            cv.centre(rows // 2 + 1, "press P to continue, Q to quit", DIM)

    def draw_hud(self, cv):
        cols, rows = cv.cols, cv.rows
        mult = min(5, 1 + self.streak // 3)
        bar = int(round((self.speed() - 3.0) / 13.0 * 8))
        segs = [("SCORE ", DIM), (fmt(self.score), WHITE if self.score > 30 else BAD),
                ("   PEAK ", DIM), (fmt(self.peak), GOLD),
                ("   BEST ", DIM), (fmt(max(self.best_before, self.peak)), TEXT),
                ("   COMBO ", DIM), ("x%d" % mult, GOOD if mult > 1 else TEXT), (" (%d)" % self.streak, DIM),
                ("   SPEED ", DIM), ("\u25ae" * max(1, bar), mix(GOOD, BAD, bar / 8.0)),
                ("\u25af" * (8 - max(1, bar)), (60, 70, 85))]
        cv.segments(1, 0, segs)
        if self.mode != "classic":
            cv.text_at(cols - 16, 0, "DAILY CHALLENGE", MAGENTA)
        end = cv.segments(1, 1, [("PROTEIN ", DIM)])
        prot = self.protein[-(cols - 40):]
        end = cv.segments(end, 1, [(prot, TEAL), (self.codon_buf, DIM), ("_", DIM)])
        codon_text = codon_preview(self.codon_buf)
        cv.segments(cols - 32, 1, [("CODON ", DIM), (codon_text, TEAL)])
        cv.segments(cols - 22, 1, [("Proteins built: ", DIM), (str(self.proteins), MAGENTA)])
        text, color, until = self.msg
        if self.t < until:
            cv.centre(2, text, color)
        next_primer = "".join(PAIR[b] for b in self.next_target_seq)
        next_segments = [("NEXT: ", DIM)] + [(b, BASE_COLORS[b]) for b in next_primer]
        cv.segments(1, 3, next_segments)
        lane_label = "MATCH UP: " if self.target_lane == "upper" else "MATCH DOWN: "
        match_segments = [(lane_label, DIM)] + [(b, BASE_COLORS[b]) for b in self.target_seq]
        match_width = sum(len(text) for text, _ in match_segments)
        cv.segments(cols - match_width - 1, 3, match_segments)
        if self.t < self.helicase_until:
            cv.text_at(cols // 2 - 7, 3, "HELICASE %.1fs" % (self.helicase_until - self.t), TEAL)
        hint = [("ARROWS/WASD", WHITE), (" steer  ", DIM), ("SPACE", WHITE), (" boost  ", DIM),
                ("1", WHITE), (" Hel:%d  " % self.power.get("1"), TEAL if self.power.get("1") else DIM),
                ("2", WHITE), (" Auto:%d  " % self.power.get("2"), GOLD if self.power.get("2") else DIM),
                ("P", WHITE), (" pause  ", DIM), ("Q", WHITE), (" quit", DIM)]
        cv.segments(1, rows - 1, hint)


