def clamp(x, lo=0.0, hi=1.0):
    return lo if x < lo else hi if x > hi else x


def mix(c1, c2, w):
    w = clamp(w)
    return tuple(int(round(a + (b - a) * w)) for a, b in zip(c1, c2))


def shade(c, f):
    return tuple(min(255, max(0, int(v * f))) for v in c)


def fmt(n):
