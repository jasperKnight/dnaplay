def run_screen(scr, paint, accept):
    """Animate `paint` until a key in `accept` is pressed ("*" = any key)."""
    t0 = last = time.monotonic()
    while True:
        cv = scr.canvas()
        if scr.too_small():
            cv.centre(cv.rows // 2, "Please make the window at least 80x24", GOLD)
        else:
            paint(cv, time.monotonic() - t0)
        scr.show()
        for k in read_keys(1.0 / 15):
            last = time.monotonic()
            if k in accept or "*" in accept:
                return accept.get(k, accept.get("*"))
        if time.monotonic() - last > IDLE_EXIT:
            return "quit"


def paint_stars(cv, t, n=60):
    rng = random.Random(3)
    for _ in range(n):
        x, y, ph = rng.random() * cv.w, rng.random() * cv.h, rng.random() * 6.3
        tw = 0.5 + 0.5 * math.sin(t * 1.7 + ph)
        cv.dot(x, y, shade(NEON[int(ph) % len(NEON)], 0.25 + 0.6 * tw))


def paint_title(cv, t, word="DNA PLAY"):
    scale = 2 if cv.rows >= 30 else 1
    width = len(word) * 6 * scale
    x0 = (cv.w - width) // 2
    for n, ch in enumerate(word):
        c = NEON[int(n + t * 2) % len(NEON)]
        cv.glyph(x0 + n * 6 * scale, 4, ch, scale, mix(c, WHITE, 0.25))
    return 1 + (4 + 7 * scale) // 4 + 1


def paint_board(cv, col, row, title, rows_, me, count):
    cv.text_at(col, row, title, ACCENT)
    cv.text_at(col, row + 1, "-" * 34, (60, 70, 85))
    if not rows_:
        cv.text_at(col, row + 2, "no scores yet - be the first!", DIM)
    for n, e in enumerate(rows_):
        line = "%2d. %-18s %9s" % (n + 1, e[1][:18], fmt(e[0]))
        color = GOLD if n == 0 else (TEAL if e[1] == me else TEXT)
        cv.text_at(col, row + 2 + n, line + ("  <- you" if e[1] == me else ""), color)


def paint_boards(cv, row, entries, me):
    left = max(2, cv.cols // 2 - 38)
    paint_board(cv, left, row, "TOP SCIENTISTS (classic)", board(entries, "classic", 10), me, 10)
    paint_board(cv, cv.cols // 2 + 2, row, "TODAY'S DAILY CHALLENGE", board(entries, daily_tag(), 5), me, 5)


def title_screen(scr, entries, source, me):
    def paint(cv, t):
        paint_stars(cv, t)
        row = paint_title(cv, t)
        cv.centre(row, "B A S E   P A I R   B I N D E R", TEAL)
        cv.centre(row + 1, "pair the primer, bind the strand, build a protein", DIM)
        paint_boards(cv, row + 3, entries, me)
        if source != "shared":
            cv.centre(cv.rows - 3, "(shared scoreboard unavailable - showing your personal scores)", BAD)
        cv.centre(cv.rows - 2, "[ENTER] play    [D] daily challenge    [T] tutorial    [L] polymer lab    [Q] quit", WHITE)
    return run_screen(scr, paint, {"enter": "play", "drop": "play", "d": "daily", "t": "tutorial",
                                   "l": "learn", "q": "quit", "esc": "quit"})


def bases_line(seq, color=None):
    out = []
    for b in seq:
        out.append((b, color or BASE_COLORS.get(b, TEXT)))
        out.append(("  ", TEXT))
    return out


CODON_NAMES = {
    "A": "Alanine", "R": "Arginine", "N": "Asparagine", "D": "Aspartic acid",
    "C": "Cysteine", "E": "Glutamic acid", "Q": "Glutamine", "G": "Glycine",
    "H": "Histidine", "I": "Isoleucine", "L": "Leucine", "K": "Lysine",
    "M": "Methionine", "F": "Phenylalanine", "P": "Proline", "S": "Serine",
    "T": "Threonine", "W": "Tryptophan", "Y": "Tyrosine", "V": "Valine",
    "*": "Stop"
}


def codon_label(codon):
    aa = CODONS.get(codon, "?")
    if aa == "*":
        return "STOP"
    if aa == "?":
        return "?"
    return "%s (%s)" % (aa, CODON_NAMES.get(aa, aa))


def codon_preview(seq):
    if not seq:
        return "no codon yet"
    if len(seq) < 3:
        return "%s (%d/3 bases)" % (seq, len(seq))
    codon = seq[:3]
    return "%s -> %s" % (codon, codon_label(codon))


