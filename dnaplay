def rgb_to_256(r, g, b):
    if abs(r - g) < 12 and abs(g - b) < 12:
        gray = (r + g + b) // 3
        return 16 if gray < 8 else 231 if gray > 248 else 232 + int(round((gray - 8) / 247 * 23))
    return 16 + 36 * int(round(r / 255 * 5)) + 6 * int(round(g / 255 * 5)) + int(round(b / 255 * 5))


_SEQ = {}


def color_seq(rgb, mode):
    if rgb is None or mode == "none":
        return ""
    key = (rgb, mode)
    if key not in _SEQ:
        if mode == "true":
            _SEQ[key] = "\x1b[38;2;%d;%d;%dm" % rgb
        else:
            _SEQ[key] = "\x1b[38;5;%dm" % rgb_to_256(*rgb)
    return _SEQ.get(key)


def detect_color_mode():
    if os.environ.get("NO_COLOR"):
        return "none"
    ct = os.environ.get("COLORTERM", "").lower()
    if "truecolor" in ct or "24bit" in ct or "direct" in os.environ.get("TERM", ""):
        return "true"
    return "256"


def terminal_size():
    try:
        sz = os.get_terminal_size(1)
        return sz.columns, sz.lines
    except OSError:
        sz = shutil.get_terminal_size((80, 24))
        return sz.columns, sz.lines


DOT_BITS = ((0x01, 0x02, 0x04, 0x40), (0x08, 0x10, 0x20, 0x80))
BLANK = (" ", "")


class Canvas:
    """Grid of cells.  Each cell shows Braille dots or one text character."""

    def __init__(self, cols, rows):
        self.cols, self.rows, self.w, self.h = cols, rows, cols * 2, rows * 4
        self.ox = 0                                   # shake offset (columns)
        self.clear()

    def clear(self):
        n = self.cols * self.rows
        self.mask, self.color, self.text = [0] * n, [None] * n, [None] * n

    def dot(self, x, y, color):
        x, y = int(x) + 2 * self.ox, int(y)
        if 0 <= x < self.w and 0 <= y < self.h:
            i = (y >> 2) * self.cols + (x >> 1)
            if self.text[i] is None:                  # never recolour a letter
                self.mask[i] |= DOT_BITS[x & 1][y & 3]
                self.color[i] = color

    def text_at(self, col, row, s, color):
        col, row = int(col) + self.ox, int(row)
        if 0 <= row < self.rows:
            for k, ch in enumerate(s):
                c = col + k
                if 0 <= c < self.cols and ch != " ":
                    i = row * self.cols + c
                    self.text[i] = ch
                    self.color[i] = color

    def centre(self, row, s, color):
        self.text_at((self.cols - len(s)) // 2, row, s, color)

    def segments(self, col, row, segs):
        """Write [(text, colour), ...] one after another; returns the end column."""
        for s, c in segs:
            self.text_at(col, row, s, c)
            col += len(s)
        return col

    def glyph(self, x, y, ch, scale, color):
        rows = FONT.get(ch, FONT.get(" ")).split("/")
        for ry, line in enumerate(rows):
            for rx, px in enumerate(line):
                if px == "#":
                    for dy in range(scale):
                        for dx in range(scale):
                            self.dot(x + rx * scale + dx, y + ry * scale + dy, color)


class Renderer:
    """Only sends the cells that changed since the last frame."""

    def __init__(self, cols, rows, mode):
        self.cols, self.rows, self.mode = cols, rows, mode
        self.front = [BLANK] * (cols * rows)

    def render(self, cv):
        out, last, cur = [], -2, None
        for i in range(self.cols * self.rows):
            ch = cv.text[i]
            if ch is None:
                ch = chr(0x2800 + cv.mask[i]) if cv.mask[i] else " "
            state = BLANK if ch == " " else (ch, color_seq(cv.color[i], self.mode))
            if self.front[i] == state:
                continue
            self.front[i] = state
            r, c = divmod(i, self.cols)
            if i != last + 1 or c == 0:
                out.append("\x1b[%d;%dH" % (r + 1, c + 1))
            last = i
            ch, seq = state
            if seq and seq != cur:
                out.append(seq)
                cur = seq
            out.append(ch)
        return "".join(out).encode("utf-8")


def write_all(fd, data):
    view = memoryview(data)
    while view:
        try:
            view = view[os.write(fd, view):]
        except BlockingIOError:
            select.select([], [fd], [], 0.1)


class TerminalGuard:
    """Alternate screen + cbreak input; ALWAYS restores the terminal."""

    def __enter__(self):
        self.saved = termios.tcgetattr(0)
        tty.setcbreak(0)
        termios.tcflush(0, termios.TCIFLUSH)
        write_all(1, b"\x1b[?1049h\x1b[?25l\x1b[?7l\x1b[2J")
        return self

    def __exit__(self, *exc):
        try:
            write_all(1, b"\x1b[0m\x1b[?7h\x1b[?25h\x1b[?1049l")
        finally:
            termios.tcsetattr(0, termios.TCSAFLUSH, self.saved)
        return False


KEYMAP = {" ": "drop", "\r": "enter", "\n": "enter", "a": "left", "d": "right",
          "w": "up", "s": "down", "h": "left", "j": "down", "k": "up", "l": "right"}


def read_keys(timeout):
    """Wait up to `timeout` seconds; return the keys pressed as names."""
    ready, _, _ = select.select([0], [], [], max(0.0, timeout))
    if not ready:
        return []
    try:
        data = os.read(0, 64).decode("latin-1")
    except OSError:
        return []
    keys, i = [], 0
    while i < len(data):
        if data.startswith("\x1b[", i) or data.startswith("\x1bO", i):
            keys.append({"D": "left", "C": "right", "A": "up", "B": "down"}.get(data[i + 2:i + 3], ""))
            i += 3
        else:
            ch = data[i].lower()
            keys.append(KEYMAP.get(ch, "esc" if ch == "\x1b" else ch))
            i += 1
    return [k for k in keys if k]


class Screen:
    """Owns the canvas; rebuilds it when the window is resized."""

    def __init__(self):
        self.mode, self.resized, self.cv = detect_color_mode(), True, None
        signal.signal(signal.SIGWINCH, self._winch)

    def _winch(self, signum, frame):
        self.resized = True

    def canvas(self):
        if self.resized:
            self.resized = False
            cols, rows = terminal_size()
            self.cv = Canvas(cols, rows - 1)
            self.rend = Renderer(cols, rows - 1, self.mode)
            write_all(1, b"\x1b[0m\x1b[2J")
        self.cv.clear()
        self.cv.ox = 0
        return self.cv

    def too_small(self):
        return self.cv.cols < 80 or self.cv.rows < 23

    def show(self):
        data = self.rend.render(self.cv)
        if data:
            write_all(1, data)


