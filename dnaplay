def polymer_lab(scr):
    page = 0
    while 0 <= page < len(POLYMER_GUIDE):
        title, lines = POLYMER_GUIDE[page]

        def paint(cv, t, title=title, lines=lines, page=page):
            paint_stars(cv, t, 30)
            cv.centre(2, "POLYMER LAB", GOLD)
            cv.centre(4, title, TEAL)
            left = max(2, (cv.cols - 78) // 2)
            for n, segs in enumerate(lines):
                cv.segments(left, 7 + n, segs)
            cv.centre(cv.rows - 2, "[any key] close    [LEFT] back    [Q] quit", WHITE)
        res = run_screen(scr, paint, {"left": "back", "q": "quit", "esc": "quit", "*": "close"})
        if res in ("quit", "close"):
            break
        page += -1 if res == "back" else 1


def tutorial(scr):
    page = 0
    while 0 <= page < len(TUTORIAL):
        title, lines = TUTORIAL[page]

        def paint(cv, t, title=title, lines=lines, page=page):
            paint_stars(cv, t, 30)
            cv.centre(2, "HOW TO PLAY  (%d/%d)" % (page + 1, len(TUTORIAL)), GOLD)
            cv.centre(4, title, TEAL)
            left = max(2, (cv.cols - 78) // 2)
            for n, segs in enumerate(lines):
                cv.segments(left, 7 + n, segs)
            cv.centre(cv.rows - 2, "[any key] next    [LEFT] back    [Q] skip", WHITE)
        res = run_screen(scr, paint, {"left": "back", "q": "skip", "esc": "skip", "*": "next"})
        if res in ("skip", "quit"):
            break
        page += -1 if res == "back" else 1
    try:
        with open(SEEN_FILE, "a"):
            pass
    except OSError:
        pass


def play(scr, mode, seed, best, demo=False):
    game = Game(mode, seed, best, demo)
    paused, last_key, last = False, time.monotonic(), time.monotonic()
    while True:
        now = time.monotonic()
        dt, last = min(0.1, now - last), now
        cv = scr.canvas()
        small = scr.too_small()
        if not (paused or small or game.over):
            game.update(dt, cv.cols, cv.rows)
        if small:
            cv.centre(cv.rows // 2, "Please make the window at least 80x24 (paused)", GOLD)
        else:
            game.draw(cv, paused)
        scr.show()
        if game.over:
            cv = scr.canvas()
            game.draw(cv)
            cv.centre(cv.rows // 2, "  G A M E   O V E R  ", BAD)
            scr.show()
            time.sleep(1.5)
            termios.tcflush(0, termios.TCIFLUSH)
            return game
        for k in read_keys(max(0.0, 1.0 / FPS - (time.monotonic() - now))):
            last_key = time.monotonic()
            if k in ("q", "esc"):
                game.over, game.reason = True, "You quit."
            elif k == "p":
                paused = not paused
            elif not paused:
                game.key(k)
        if not demo and time.monotonic() - last_key > IDLE_EXIT:
            game.over, game.reason = True, "No key pressed for 2 minutes."


def game_over_screen(scr, game, entries, me, new_best, top):
    fact = random.choice(FACTS)

    def paint(cv, t):
        paint_stars(cv, t, 40)
        cv.centre(1, "G A M E   O V E R", BAD)
        cv.centre(2, game.reason, DIM)
        cv.centre(4, "PEAK SCORE  %s" % fmt(game.peak), GOLD)
        if top:
            cv.centre(5, "*** NEW TOP SCIENTIST! ***", NEON[int(t * 6) % len(NEON)])
        elif new_best:
            cv.centre(5, "NEW PERSONAL BEST!", GOOD)
        cv.centre(6, "binds %d   best combo %d   proteins %d" % (game.binds, game.best_streak, game.proteins), TEXT)
        for n, line in enumerate(textwrap.wrap("Did you know?  " + fact, min(76, cv.cols - 4))):
            cv.centre(8 + n, line, TEAL)
        paint_boards(cv, 11, entries, me)
        cv.centre(cv.rows - 2, "[ENTER] play again    [D] daily challenge    [Q] quit", WHITE)
    return run_screen(scr, paint, {"enter": "play", "drop": "play", "d": "daily", "q": "quit", "esc": "quit"})


