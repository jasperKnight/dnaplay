def clean_user(name):
    """Safe display name: drop any @domain, keep A-Z a-z 0-9 . _ - only."""
    return re.sub(r"[^A-Za-z0-9._-]", "", name.split("@")[0])[:24] or "unknown"


def login_name():
    try:
        return clean_user(pwd.getpwuid(os.getuid()).pw_name)
    except KeyError:
        return "uid%d" % os.getuid()


def ensure_score_dir(directory):
    """Create a score directory if needed without failing the game."""
    try:
        os.makedirs(directory, exist_ok=True)
    except OSError:
        pass


def _open_regular(path, flags, perm=0o664):
    """Open only a real file (never a symlink, FIFO or device)."""
    fd = os.open(path, flags | os.O_NOFOLLOW | os.O_NONBLOCK, perm)
    if not stat.S_ISREG(os.fstat(fd).st_mode):
        os.close(fd)
        raise OSError("not a regular file: " + path)
    return fd


def save_score(user, mode, score, combo, proteins):
    """Append one line.  Returns the file used, or None."""
    line = "%d\t%s\t%s\t%d\t%d\t%d\n" % (int(time.time()), user, mode, score, combo, proteins)
    ensure_score_dir(os.path.dirname(SCORE_FILE) or ".")
    for path, perm in ((SCORE_FILE, 0o664), (PERSONAL_FILE, 0o600)):
        try:
            fd = _open_regular(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, perm)
        except OSError:
            continue
        try:
            if os.fstat(fd).st_uid == os.getuid():
                os.fchmod(fd, perm)
            fcntl.flock(fd, fcntl.LOCK_EX)
            write_all(fd, line.encode("ascii"))
            return path
        except OSError:
            continue
        finally:
            os.close(fd)
    return None


def load_scores():
    """Returns (entries, source).  Bad or hostile lines are ignored."""
    for path, label in ((SCORE_FILE, "shared"), (PERSONAL_FILE, "personal")):
        try:
            fd = _open_regular(path, os.O_RDONLY)
        except OSError:
            continue
        try:
            fcntl.flock(fd, fcntl.LOCK_SH)
            chunks = []
            while sum(len(c) for c in chunks) < 4000000:
                chunk = os.read(fd, 65536)
                if not chunk:
                    break
                chunks.append(chunk)
        except OSError:
            continue
        finally:
            os.close(fd)
        entries = []
        for raw in b"".join(chunks).decode("ascii", "replace").splitlines():
            parts = raw.split("\t")
            if len(parts) != 6 or not re.fullmatch(r"[a-z0-9:-]{1,20}", parts[2]):
                continue
            try:
                ts, score, combo, prot = (int(parts[n]) for n in (0, 3, 4, 5))
            except ValueError:
                continue
            if 0 <= score < 10 ** 8:
                entries.append((score, clean_user(parts[1]), parts[2], ts, combo, prot))
        return entries, label
    return [], "none"


def board(entries, mode, limit):
    """Best score per user for one mode, highest first."""
    best = {}
    for e in entries:
        prev = best.get(e[1])
        if e[2] == mode and (prev is None or e[0] > prev[0]):
            best[e[1]] = e
    return sorted(best.values(), key=lambda e: -e[0])[:limit]


def personal_best(entries, user, mode):
    return max([e[0] for e in entries if e[1] == user and e[2] == mode] + [0])


