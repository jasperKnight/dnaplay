        print()
    print("(source: %s)" % source)


def parse_args(argv):
    parser = argparse.ArgumentParser(
        prog="dnaplay",
        description="Base Pair Binder - a terminal DNA game",
        epilog="Examples: dnaplay --tutorial | dnaplay --daily | dnaplay --demo | dnaplay --scores",
    )
    parser.add_argument("--daily", action="store_true", help="start a shared daily challenge")
    parser.add_argument("--demo", action="store_true", help="watch the computer play")
    parser.add_argument("--scores", action="store_true", help="print the scoreboard and exit")
    parser.add_argument("--tutorial", action="store_true", help="show the tutorial before starting")
    parser.add_argument("--version", action="version", version="%(prog)s 1.0")
    return parser.parse_args(argv)


def main(argv):
    args = parse_args(argv)
    if args.scores:
        print_scores()
        return 0
    if not (os.isatty(0) and os.isatty(1)):
        print("dnaplay needs an interactive terminal.")
        return 1
    lang = os.environ.get("LANG", "")
    ctype = os.environ.get("LC_CTYPE", "")
    if ctype.lower() in ("c.utf-8", "c.utf8") and lang in ("", "C", "POSIX"):
        ctype = ""                                    # set by Python itself, not the user
    if "utf" not in (os.environ.get("LC_ALL") or ctype or lang).lower():
        print("dnaplay needs a UTF-8 locale, for example:  LANG=en_US.UTF-8 dnaplay")
        return 1
    cols, rows = terminal_size()
    if cols < 80 or rows < 24:
        print("Please make the window at least 80x24 (it is %dx%d)." % (cols, rows))
        return 1
    try:
        os.nice(10)                                   # be polite on a shared server
    except OSError:
        pass
    me = login_name()
    signal.signal(signal.SIGTERM, lambda s, f: sys.exit(0))
    signal.signal(signal.SIGHUP, lambda s, f: sys.exit(0))
    with TerminalGuard():
        scr = Screen()
        if not args.demo and (args.tutorial or not os.path.exists(SEEN_FILE)):
            tutorial(scr)
        choice = "demo" if args.demo else ("daily" if args.daily else None)
        while True:
            entries, source = load_scores()
            if choice is None:
                choice = title_screen(scr, entries, source, me)
            if choice == "tutorial":
                tutorial(scr)
                choice = None
                continue
            if choice == "learn":
                polymer_lab(scr)
                choice = None
                continue
            if choice not in ("play", "daily", "demo"):
                break
            mode = daily_tag() if choice == "daily" else "classic"
            seed = mode if choice == "daily" else None
            best = personal_best(entries, me, mode)
            top_before = max([e[0] for e in entries if e[2] == mode] + [0])
            game = play(scr, mode, seed, best, demo=choice == "demo")
            recorded = bool(game.binds and choice != "demo")
            if recorded:
                save_score(me, mode, game.peak, game.best_streak, game.proteins)
            entries, source = load_scores()
            choice = game_over_screen(scr, game, entries, me, game.peak > best and recorded,
                                      game.peak > top_before and recorded)
            if choice == "quit":
                break
    print("Thanks for playing, %s!  Scores: dnaplay --scores" % me)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(0)
